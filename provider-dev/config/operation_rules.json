{
  "_comment": "Operation mapping rules for the railway provider. The walk in provider-dev/scripts/lib/schema_walk.mjs names resources and methods mechanically (Railway's <noun><Verb> convention); this file holds the decisions the mechanics cannot make. Keys are GraphQL field names on Query / Mutation. Every change here is a mapping change: run `make generate` and review the all_services.csv diff.",
  "verbs": [
    "Create",
    "Update",
    "Delete",
    "Remove",
    "Add",
    "Upsert",
    "Set",
    "Unset",
    "Rename",
    "Use",
    "Accept",
    "Resend",
    "Approve",
    "Cancel",
    "Redeploy",
    "Restart",
    "Rollback",
    "Stop",
    "Deploy",
    "DeployV2",
    "Connect",
    "Disconnect",
    "Attach",
    "Detach",
    "Reset",
    "Configure",
    "Clone",
    "Generate",
    "Publish",
    "Unpublish",
    "Revert",
    "Claim",
    "Leave",
    "Transfer",
    "Schedule",
    "Commit",
    "Restage",
    "Lock",
    "Restore",
    "Dispatch",
    "Recover",
    "Wake",
    "Sleep",
    "Fork",
    "Exec",
    "Heartbeat",
    "Destroy",
    "Test",
    "Replace",
    "Snooze",
    "Invite",
    "Issue",
    "Unskip"
  ],
  "uncountable": [
    "status",
    "stats",
    "info",
    "compliance",
    "usage",
    "health",
    "progress",
    "access",
    "preferences",
    "egress",
    "metrics",
    "history",
    "work"
  ],
  "skip": {
    "_comment": "kind.fieldName -> reason code. Reason codes are documented in NOTES.md.",
    "query.adminVolumeInstancesForVolume": "platform_admin_only",
    "query.changelogBlockImage": "website_content",
    "query.devNewLandingTarget": "internal_development_surface",
    "query.sshSignupInfo": "interactive_auth_flow",
    "mutation.devNewLandingTargetClear": "internal_development_surface",
    "mutation.devNewLandingTargetSet": "internal_development_surface",
    "mutation.fairUseAgree": "legal_consent_flow",
    "mutation.userTermsUpdate": "legal_consent_flow",
    "mutation.sshSignupApprove": "interactive_auth_flow",
    "query.projectToken": "project_token_auth_only"
  },
  "skipPatterns": [
    [
      "^loginSession",
      "interactive_auth_flow",
      "mutation"
    ],
    [
      "^emailChange",
      "interactive_auth_flow",
      "mutation"
    ],
    [
      "^twoFactorInfo(Create|Delete|Secret|Validate)$",
      "interactive_auth_flow",
      "mutation"
    ],
    [
      "^recoveryCode",
      "interactive_auth_flow",
      "mutation"
    ],
    [
      "EventTrack$",
      "client_telemetry",
      "mutation"
    ],
    [
      "^cloudAgent(StateReport|FeedbackCreate)$",
      "client_telemetry",
      "mutation"
    ]
  ],
  "unwrap": {
    "_comment": "Root queries that return a wrapper object around the rows. items is the field holding the rows; cursor describes non-Relay pagination where the wrapper carries it.",
    "apiToken": {
      "items": "workspaces"
    },
    "cloudAgentTasks": {
      "items": "tasks",
      "cursor": {
        "arg": "cursor",
        "path": "nextCursor",
        "limitArg": "limit"
      }
    },
    "httpDurationMetrics": {
      "items": "samples"
    },
    "httpMetrics": {
      "items": "samples"
    },
    "projectServiceUsage": {
      "items": "usage",
      "cursor": {
        "arg": "after",
        "path": "pageInfo.endCursor",
        "hasNext": "pageInfo.hasNextPage",
        "pageSizeArg": "first",
        "pageSize": 50
      }
    },
    "projectWorkspaceMembers": {
      "items": "members"
    }
  },
